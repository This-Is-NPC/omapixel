# The last-horizon photograph dissolving into the retro-82 omarchy
# wallpaper, and back again. Generated -- see examples/README.md.
#
#   omapixel new last-horizon-omarchy.json --size 160x90
#   omapixel batch last-horizon-omarchy.json --script last-horizon-omarchy.batch

# Out with the seventeen a new document starts with, and in with one ramp
# darkest to lightest over both pictures -- a swatch strip you can read.
palette rm --slot I
palette rm --slot C
palette rm --slot A
palette rm --slot K
palette rm --slot D
palette rm --slot F
palette rm --slot L
palette rm --slot E
palette rm --slot H
palette rm --slot N
palette rm --slot T
palette rm --slot S
palette rm --slot R
palette rm --slot Y
palette rm --slot G
palette rm --slot B
palette rm --slot P

palette set --slot A --colour "#09090A"
palette set --slot B --colour "#141112"
palette set --slot C --colour "#05182E"
palette set --slot D --colour "#291916"
palette set --slot E --colour "#352622"
palette set --slot F --colour "#342E2B"
palette set --slot G --colour "#522E23"
palette set --slot H --colour "#4F342B"
palette set --slot I --colour "#1D475E"
palette set --slot J --colour "#4B4038"
palette set --slot K --colour "#37484E"
palette set --slot L --colour "#67463A"
palette set --slot M --colour "#455156"
palette set --slot N --colour "#8A452F"
palette set --slot O --colour "#6F564E"
palette set --slot P --colour "#576463"
palette set --slot Q --colour "#54708A"
palette set --slot R --colour "#936D61"
palette set --slot S --colour "#617A85"
palette set --slot T --colour "#6F817A"
palette set --slot U --colour "#6D8791"
palette set --slot V --colour "#A9857A"
palette set --slot W --colour "#6D9DA8"
palette set --slot X --colour "#C28E7A"
palette set --slot Y --colour "#B2948E"
palette set --slot Z --colour "#969DA5"
palette set --slot a --colour "#B0A3A2"
palette set --slot b --colour "#98AAB2"
palette set --slot c --colour "#C7A9A2"
palette set --slot d --colour "#FAA968"
palette set --slot e --colour "#A0BBC7"
palette set --slot f --colour "#ADC9D2"
palette set --slot g --colour "#C2D6E6"
palette set --slot h --colour "#D4D7D8"
palette set --slot i --colour "#E0EAEB"

clip rename idle transition
clip fps --name transition --fps 12

